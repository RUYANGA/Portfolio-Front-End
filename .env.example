# Frontend settings. Locally: copy to .env.local.
# On Vercel: add these under Project → Settings → Environment Variables (Production),
# then redeploy. NEXT_PUBLIC_* values are baked in at build time.

# The Django API, used by the site's server (pages, admin dashboard proxy).
# Production: https://api.ruyanga.tech
API_URL=http://localhost:8000

# The same API, as seen from visitors' browsers (contact form, live API panel).
# Production: https://api.ruyanga.tech
NEXT_PUBLIC_API_URL=http://localhost:8000

# This site's public address, for metadata and the sitemap.
# Production: https://ruyanga.tech
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Visitor analytics: the same random value as ANALYTICS_KEY on the backend. Server-only (no NEXT_PUBLIC_).
# Without it, production doesn't record visits. Visits while signed in to /admin aren't counted.
ANALYTICS_KEY=
